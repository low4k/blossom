# Blossom — Environment Variables
# Copy to .env or set in your hosting dashboard (Railway, etc.)
# Every deployment should use UNIQUE paths to avoid pattern detection.

# --- Server ---
PORT=8080

# --- Path Randomization ---
# CRITICAL: Change these per deployment. Use random-looking but normal paths.
# These values should be unique to YOUR deployment.
PROXY_PREFIX=/cdn/m/
EPOXY_PREFIX=/cdn/n/
BAREMUX_PREFIX=/cdn/w/
WISP_PATH=/sock/
SCRAMJET_PREFIX=/~/

# --- Hosting ---
# If using Cloudflare proxy in front, you may want to trust CF headers:
# TRUST_PROXY=true
