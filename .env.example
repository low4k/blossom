PORT=8080

PROXY_PREFIX=/cdn/m/
EPOXY_PREFIX=/cdn/n/
BAREMUX_PREFIX=/cdn/w/
WISP_PATH=/sock/
SCRAMJET_PREFIX=/~/

# Dev account seeded on first run (required to get an admin account)
DEV_EMAIL=
DEV_PASS=

# Comma-separated mirror URLs for domain survival failover (optional)
# MIRRORS=https://mirror1.example.com,https://mirror2.example.com

# Registration gate (optional)
# REGISTRATION=closed        # disable self-registration entirely
# INVITE_CODE=shared-secret  # require this code to register

# --- Anti-CAPTCHA middleware (all optional, sensible defaults) ---
# Captcha-session vault watch list (hosts whose cookies get persisted and
# re-seeded after session loss). Bare hostnames match subdomains.
# CAPTCHA_WATCH_HOSTS=google.com,reddit.com,recaptcha.net,hcaptcha.com,challenges.cloudflare.com
# Server-side keep-alive: pings a benign endpoint per vault entry with the
# stored cookies to keep tokens warm. Interval seconds, 0 disables.
# CAPTCHA_REFRESH_SECONDS=300
# Optional CONNECT proxy for server-origin keep-alive probes (Phase 2: point
# this at a local uTLS/curl-impersonate CONNECT sidecar to proxy a genuine
# Chrome TLS fingerprint). Empty = direct egress.
# STEALTH_PROXY_URL=http://127.0.0.1:8888
# Optional solver sidecar (Phase 3): any open-source HTTP service (Camoufox,
# Turnstile-solver style) implementing POST /solve {host,url,cookies} ->
# {cookies:[...]}. Disabled when unset.
# SOLVER_URL=http://127.0.0.1:3010
# SOLVER_TIMEOUT_MS=45000

# Blossom AI (server-side only — never put the key in client JS or git)
# BAI_API_KEY=
# BAI_BASE_URL=https://api.b.ai/v1

# Donate page buttons (optional). Leave empty to show “not set yet”.
# DONATE_CASHAPP_URL=https://cash.app/$yourcashtag
# DONATE_PAYPAL_URL=https://paypal.me/yourname

# TEST-ONLY: relax wisp private/loopback blocks (local test targets).
# Never enable in production.
# WISP_ALLOW_PRIVATE=0
